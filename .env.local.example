# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the seed script. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Groq → console.groq.com/keys (server only)
GROQ_API_KEY=

# The email of your Supabase Auth user. The seed script attaches rows to this account.
SEED_USER_EMAIL=

# MCP server (v2). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_SECRET=
# Your Supabase Auth user id (Authentication → Users). The MCP server writes as this user.
COMPOUND_USER_ID=
# Your timezone, so "today" in chat matches the app, e.g. Asia/Kolkata.
COMPOUND_TIMEZONE=
